PORT=3001
DATA_MODE=mongo
MONGODB_URI=mongodb://127.0.0.1:27017/HOMESTAY_QUY_TEST
JWT_SECRET=replace-with-a-long-random-secret
# Dia chi website trong email dat lai mat khau
APP_URL=http://localhost:3001
# Dien SMTP that de gui email; khong luu mat khau vao Git
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Xem docs/EMAIL_VA_HO_SO.md. Gmail dung mat khau ung dung.
# SMTP_PORT=465 voi SMTP_SECURE=true; 587 voi false (STARTTLS).

# AI: disabled / groq / ollama; setup-ai.sh kiem tra va luu tu dong
AI_PROVIDER=disabled
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# payOS: setup-payos.sh; không gửi secret tới trình duyệt
PUBLIC_BASE_URL=http://localhost:3001
PAYOS_HOMESTAY_ID=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_CHANNELS_JSON=
# VPS Docker sets HOST=0.0.0.0 and TRUST_PROXY=1 behind Caddy only.

# Sprint 4: sao luu ma hoa luc 02:00 gio Viet Nam khi server dang chay
BACKUP_ENABLED=false
BACKUP_DIR=
# Luu BACKUP_KEY rieng (toi thieu 32 ky tu). Neu de trong, dung JWT_SECRET.
BACKUP_KEY=
# Chi dung khi chay bo du lieu QA/DEMO tach biet; mac dinh data/homestay.json
HOMESTAY_DATA_FILE=

# 1.8.4: dùng mô hình diễn đạt với dữ liệu do máy chủ kiểm chứng; false để tắt riêng bước này
AI_NATURAL_RESPONSE=true
