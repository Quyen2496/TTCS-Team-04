{
  "name": "homestay-solo-test",
  "version": "1.9.0",
  "private": true,
  "description": "HOMESTAY Sprint 4 — quyết toán, hoá đơn, email, báo cáo và sao lưu",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test test/*.test.js",
    "setup:demo": "bash scripts/setup.sh --demo",
    "setup:mongo": "bash scripts/setup.sh --mongo",
    "update-data": "node scripts/seed.js",
    "test:sprint3": "node --test test/sprint3.test.js",
    "setup:email": "bash scripts/setup-email.sh",
    "check:email": "node scripts/check-email.js",
    "setup:ai": "bash scripts/setup-ai.sh",
    "test:ai": "node --test test/ai*.test.js",
    "setup:payos": "bash scripts/setup-payos.sh",
    "check:production": "node deploy/check-production.cjs",
    "test:payos": "node --test test/payos.test.js",
    "test:sprint4": "node --test test/sprint4*.test.js",
    "seed:sprint4-demo": "node scripts/seed-sprint4-demo.js",
    "backup": "node scripts/backup.js",
    "restore:qa": "node scripts/restore-qa.js",
    "restore:mongo-qa": "node scripts/restore-mongo-qa.js",
    "setup:sprint4": "node scripts/setup-sprint4.js",
    "check:ai": "node scripts/check-ai.js",
    "update:collection": "node scripts/update-collection.js",
    "preview:collection": "node scripts/update-collection.js --preview",
    "test:collection": "node --test test/collection.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@payos/node": "2.0.5",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.8.4",
    "nodemailer": "^7.0.13",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.5"
  }
}
